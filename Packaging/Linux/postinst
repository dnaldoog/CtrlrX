#!/bin/sh
# Copies the VST3 bundle CtrlrX ships under a package-owned path
# (/usr/local/share/ctrlrx/vst3) into the invoking (non-root) user's
# ~/.vst3, since dpkg/rpm run this as root and cannot target a specific
# user's home directly from the package's own file list.
set -e

VST3_STAGE_DIR="/usr/local/share/ctrlrx/vst3/CtrlrX.vst3"

# Figure out who actually ran the install, not root.
REAL_USER="${SUDO_USER:-}"
if [ -z "$REAL_USER" ]; then
    REAL_USER="$(logname 2>/dev/null || true)"
fi

if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
    echo "ctrlrx: could not determine a non-root invoking user; skipping"
    echo "ctrlrx: automatic ~/.vst3 install. Copy it yourself with:"
    echo "ctrlrx:   cp -r $VST3_STAGE_DIR ~/.vst3/"
    exit 0
fi

REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)"

if [ -z "$REAL_HOME" ] || [ ! -d "$REAL_HOME" ]; then
    echo "ctrlrx: could not resolve a home directory for $REAL_USER;"
    echo "ctrlrx: copy the plugin yourself with:"
    echo "ctrlrx:   cp -r $VST3_STAGE_DIR ~/.vst3/"
    exit 0
fi

if [ ! -d "$VST3_STAGE_DIR" ]; then
    echo "ctrlrx: staged VST3 bundle not found at $VST3_STAGE_DIR, skipping"
    exit 0
fi

mkdir -p "$REAL_HOME/.vst3"
rm -rf "${REAL_HOME:?}/.vst3/CtrlrX.vst3"
cp -r "$VST3_STAGE_DIR" "$REAL_HOME/.vst3/"
chown -R "$REAL_USER:$REAL_USER" "$REAL_HOME/.vst3/CtrlrX.vst3" 2>/dev/null || true

echo "ctrlrx: installed VST3 plugin to $REAL_HOME/.vst3/CtrlrX.vst3"

exit 0
