#!/bin/bash
# If you get complaints, sudo dnf install ninja-build
# 1. Path to your project root and build directory
PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
BUILD_DIR="$PROJECT_ROOT/build"

echo "Select build type (Using Ninja):"
echo "1) Full Release (Clean + Configure + Build)"
echo "2) Full Debug (Clean + Configure + Build)"
echo "3) Clean Rebuild (Ninja Clean + Build)"
echo "4) Quick Build (Ninja Only)"
echo "5) Run tests"
read -p "Enter choice [1-5]: " choice

error_exit() {
    echo "ERROR: $1" >&2
    exit 1
}


case $choice in
    1|2)
        # Determine build type
        BUILD_TYPE="Release"
        [ "$choice" == "2" ] && BUILD_TYPE="Debug"

        echo "--- Starting Full $BUILD_TYPE Build ---"
        rm -rf "$BUILD_DIR"
        # -G Ninja tells CMake to generate Ninja files instead of Makefiles
        cmake -S "$PROJECT_ROOT" -B "$BUILD_DIR" -G Ninja -DCMAKE_BUILD_TYPE=$BUILD_TYPE
cmake --build "$BUILD_DIR" -j"$(nproc)" > build_log.txt 2>&1 || error_exit "Build failed — see build_log.txt for details."
        ;;

    3)
        # Incremental Clean
        if [ ! -d "$BUILD_DIR" ]; then echo "Run 1 or 2 first."; exit 1; fi
        echo "--- Cleaning and Rebuilding ---"
        cmake --build "$BUILD_DIR" --target clean
        cmake --build "$BUILD_DIR" -j"$(nproc)" > build_log.txt 2>&1 || error_exit "Build failed — see build_log.txt for details."
        ;;

    4)
        # Quick Rebuild
        if [ ! -d "$BUILD_DIR" ]; then echo "Run 1 or 2 first."; exit 1; fi
        echo "--- Fast Incremental Build ---"
        cmake --build "$BUILD_DIR" -j"$(nproc)" > build_log.txt 2>&1 || error_exit "Build failed — see build_log.txt for details."
        ;;

    5)
        # Run tests
        if [ ! -d "$BUILD_DIR" ]; then echo "Run 1 or 2 first."; exit 1; fi
        pushd "$BUILD_DIR/Tests"
        GTEST_OUTPUT="xml:test-results/" GTEST_COLOR=1 ctest -j"$(nproc)" --output-on-failure
        ../../Tests/ci_check_test_results.py --allow ../../Tests/known_failures_linux.txt "test-results/*.xml"
        popd
        ;;

    *)
        echo "Invalid selection. Exiting."
        exit 1
        ;;
esac
